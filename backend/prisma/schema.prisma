// schema.prisma
// Updated to match strsk.md requirements

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =====================================
// MODEL-MODEL UTAMA
// =====================================

model User {
  id                  String           @id @default(cuid())
  name                String
  email               String           @unique
  password            String
  role                Role             @default(STAFF)

  // Relasi
  incomingLetters     IncomingLetter[]
  outgoingLetters     OutgoingLetter[]
  calendarEvents      CalendarEvent[]
  notifications       Notification[]
  createdDispositions Disposition[]

  // Timestamps
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  @@map("users")
}

model IncomingLetter {
  id                         String             @id @default(cuid())
  
  // Data Surat Masuk (sesuai strsk.md)
  letterNumber               String             @unique  // Nomor Surat
  letterDate                 DateTime?                  // Tanggal Surat
  receivedDate               DateTime                   // Tanggal Penerimaan Surat
  letterNature               LetterNature       @default(BIASA)  // Sifat Surat
  subject                    String                     // Isi Ringkas
  sender                     String                     // Dari
  recipient                  String                     // Kepada
  processor                  String                     // Pengolah
  note                       String?                    // Keterangan
  
  // File attachment
  fileName                   String?
  filePath                   String?
  
  // Keterangan (KET): SRIKANDI atau Manual
  processingMethod           ProcessingMethod   @default(MANUAL)
  srikandiDispositionNumber  String?           // Nomor disposisi dari SRIKANDI (jika ada)
  
  // Disposisi (target disposisi)
  dispositionTarget          DispositionTarget?
  
  // Label: Surat Undangan (Pelaksanaan)
  isInvitation               Boolean            @default(false)
  eventDate                  DateTime?          // Tanggal kegiatan
  eventTime                  String?            // Waktu kegiatan
  eventLocation              String?            // Tempat kegiatan
  eventNotes                 String?            // Catatan tambahan
  
  // Label: Surat Perlu Tindakan
  needsFollowUp              Boolean            @default(false)
  followUpDeadline           DateTime?          // Tanggal tindakan
  
  // Tracking notifikasi
  overdueNotifiedAt          DateTime?

  // Relasi
  userId                     String
  user                       User               @relation(fields: [userId], references: [id])
  calendarEvents             CalendarEvent[]
  dispositions               Disposition[]

  // Timestamps
  createdAt                  DateTime           @default(now())
  updatedAt                  DateTime           @updatedAt

  // Indeks untuk optimasi query
  @@index([userId])
  @@index([receivedDate])
  @@index([letterNature])
  @@index([processingMethod])
  @@index([dispositionTarget])
  @@index([isInvitation])
  @@index([needsFollowUp])
  @@map("incoming_letters")
}

model OutgoingLetter {
  id                         String             @id @default(cuid())
  
  // Data Surat Keluar (sesuai strsk.md)
  letterNumber               String             @unique  // Nomor Surat
  serialNumber               Int?                       // Nomor Urut
  letterDate                 DateTime                   // Tanggal Surat
  createdDate                DateTime                   // Tanggal Pembuatan Surat
  executionDate              DateTime?                  // Tanggal Pelaksanaan
  
  // Klasifikasi
  securityClass              SecurityClass      @default(BIASA)  // Klasifikasi Keamanan
  classificationCode         String?                    // Kode Klasifikasi
  letterNature               LetterNature       @default(BIASA)  // Sifat Surat
  
  // Isi Surat
  subject                    String                     // Isi Ringkas
  sender                     String                     // Dari
  recipient                  String                     // Kepada
  processor                  String                     // Pengolah
  note                       String?                    // Keterangan
  
  // File attachment
  fileName                   String?
  filePath                   String?
  
  // Keterangan (KET): SRIKANDI atau Manual
  processingMethod           ProcessingMethod   @default(MANUAL)
  srikandiDispositionNumber  String?           // Nomor dari SRIKANDI (jika ada)
  
  // Label: Surat Undangan (Pelaksanaan)
  isInvitation               Boolean            @default(false)
  eventDate                  DateTime?          // Tanggal kegiatan
  eventTime                  String?            // Waktu kegiatan
  eventLocation              String?            // Tempat kegiatan
  eventNotes                 String?            // Catatan tambahan
  
  // Tracking notifikasi
  overdueNotifiedAt          DateTime?

  // Relasi
  userId                     String
  user                       User               @relation(fields: [userId], references: [id])
  calendarEvents             CalendarEvent[]

  // Timestamps
  createdAt                  DateTime           @default(now())
  updatedAt                  DateTime           @updatedAt

  // Indeks untuk optimasi query
  @@index([userId])
  @@index([createdDate])
  @@index([letterDate])
  @@index([securityClass])
  @@index([letterNature])
  @@index([isInvitation])
  @@map("outgoing_letters")
}

model CalendarEvent {
  id              String        @id @default(cuid())
  title           String
  description     String?
  date            DateTime
  time            String?
  location        String?
  type            EventType     @default(MEETING)
  
  // Tracking notifikasi (H-7, H-3, H-1)
  notified7Days   Boolean       @default(false)  // Notifikasi H-7
  notified3Days   Boolean       @default(false)  // Notifikasi H-3
  notified1Day    Boolean       @default(false)  // Notifikasi H-1
  
  // Relasi ke Surat (opsional - untuk track asal event)
  // Event bisa berasal dari surat masuk atau surat keluar
  incomingLetterId String?
  incomingLetter   IncomingLetter? @relation(fields: [incomingLetterId], references: [id], onDelete: Cascade)
  outgoingLetterId String?
  outgoingLetter   OutgoingLetter? @relation(fields: [outgoingLetterId], references: [id], onDelete: Cascade)
  
  // Relasi ke User yang membuat
  userId          String
  user            User          @relation(fields: [userId], references: [id])
  
  // Relasi ke Notifications
  notifications   Notification[]

  // Timestamps
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([date])
  @@index([incomingLetterId])
  @@index([outgoingLetterId])
  @@index([userId])
  @@index([type])
  @@map("calendar_events")
}

model Notification {
  id        String           @id @default(cuid())
  title     String
  message   String
  isRead    Boolean          @default(false)  // Status: Belum dibaca / Sudah dibaca
  type      NotificationType @default(INFO)
  
  // Relasi
  userId    String?          
  user      User?            @relation(fields: [userId], references: [id])
  calendarEventId String?    
  calendarEvent CalendarEvent? @relation(fields: [calendarEventId], references: [id], onDelete: Cascade)

  // Timestamps
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([userId])
  @@index([isRead])
  @@index([calendarEventId])
  @@index([createdAt])
  @@map("notifications")
}

model Disposition {
  id               String            @id @default(cuid())
  incomingLetterId String
  incomingLetter   IncomingLetter    @relation(fields: [incomingLetterId], references: [id], onDelete: Cascade)
  
  // Target disposisi
  dispositionTo    DispositionTarget
  notes            String?
  
  // Tracking
  createdById      String
  createdBy        User              @relation(fields: [createdById], references: [id])
  
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([incomingLetterId])
  @@index([createdById])
  @@index([dispositionTo])
  @@map("dispositions")
}

// =====================================
// ENUMERASI
// =====================================

enum Role {
  ADMIN
  STAFF
}

// Sifat Surat (sesuai strsk.md)
enum LetterNature {
  BIASA
  TERBATAS
  RAHASIA
  SANGAT_RAHASIA
}

// Klasifikasi Keamanan (untuk surat keluar)
enum SecurityClass {
  BIASA
  TERBATAS
}

// Keterangan: SRIKANDI atau Manual
enum ProcessingMethod {
  MANUAL
  SRIKANDI
}

// Disposisi (sesuai strsk.md)
enum DispositionTarget {
  UMPEG
  PERENCANAAN
  KAUR_KEUANGAN
  KABID
  BIDANG1
  BIDANG2
  BIDANG3
  BIDANG4
  BIDANG5
}

enum NotificationType {
  INFO
  WARNING
  SUCCESS
  ERROR
  AGENDA_REMINDER  // Untuk notifikasi H-7, H-3
}

enum EventType {
  MEETING
  APPOINTMENT 
  DEADLINE
  OTHER
}